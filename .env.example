# Copy to .env and fill in. Never commit a real key.

# Any OpenAI-compatible endpoint. The older KIMI_API_KEY / KIMI_BASE_URL / KIMI_MODEL names also work.
LLM_API_KEY='replace-with-your-key'
LLM_BASE_URL='https://api.moonshot.cn/v1'
LLM_MODEL='kimi-k2.6'

# Optional
# LLM_TEMPERATURE=0        # unset = provider default
# LLM_TIMEOUT_SECONDS=60
# PROMETHEUS_MAX_STEPS=20  # model calls + tool rounds per chat turn
